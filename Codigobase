### RUTA DE ARCHIVO: app/src/main/java/com/security/lockscreen/SecurityDeviceAdminReceiver.kt
### DESCRIPCIÓN: Controlador DPC: Bloquea físicamente la barra de estado Y BLOQUEA LA DESINSTALACIÓN POR ADB.
################################################################################

package com.security.lockscreen

import android.app.admin.DeviceAdminReceiver
import android.app.admin.DevicePolicyManager
import android.content.ComponentName
import android.content.Context
import android.content.Intent
import android.os.Build
import android.os.UserManager
import android.util.Log

/**
 * Modo Kiosco / Device Owner (Android 15 Nebula AIOS):
 * 1. Bloqueo de barra de estado: dpm.setStatusBarDisabled()
 * 2. BLOQUEO ANTI-DESINSTALACIÓN ADB:
 *    - dpm.setUninstallBlocked(adminComponent, packageName, true)
 *    - dpm.addUserRestriction(adminComponent, UserManager.DISALLOW_UNINSTALL_APPS)
 * Al ejecutarse "adb uninstall com.security.lockscreen", el sistema Android 15 aborta con:
 * Failure [DELETE_FAILED_DEVICE_POLICY_MANAGER]
 */
class SecurityDeviceAdminReceiver : DeviceAdminReceiver() {

    companion object {
        fun getComponentName(context: Context): ComponentName {
            return ComponentName(context.applicationContext, SecurityDeviceAdminReceiver::class.java)
        }

        /**
         * Inhabilita o habilita el deslizamiento de la barra de estado a nivel de hardware.
         */
        fun setStatusBarLocked(context: Context, disabled: Boolean) {
            val dpm = context.getSystemService(Context.DEVICE_POLICY_SERVICE) as? DevicePolicyManager ?: return
            val adminComponent = getComponentName(context)

            if (dpm.isDeviceOwnerApp(context.packageName)) {
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
                    val success = dpm.setStatusBarDisabled(adminComponent, disabled)
                    Log.i("LockScreenSecurity", "setStatusBarDisabled($disabled): $success")
                }
            }
        }

        /**
         * Bloquea expresamente la eliminación y desinstalación de la app vía ADB y vía Ajustes.
         */
        fun enforceAntiAdbUninstallProtection(context: Context, enableBlock: Boolean) {
            val dpm = context.getSystemService(Context.DEVICE_POLICY_SERVICE) as? DevicePolicyManager ?: return
            val adminComponent = getComponentName(context)

            if (dpm.isDeviceOwnerApp(context.packageName)) {
                // 1. Bloquear desinstalación del paquete (evita adb uninstall)
                dpm.setUninstallBlocked(adminComponent, context.packageName, enableBlock)

                // 2. Prohibir eliminación de aplicaciones en el perfil de usuario
                if (enableBlock) {
                    dpm.addUserRestriction(adminComponent, UserManager.DISALLOW_UNINSTALL_APPS)
                    dpm.addUserRestriction(adminComponent, UserManager.DISALLOW_APPS_CONTROL)
                } else {
                    dpm.clearUserRestriction(adminComponent, UserManager.DISALLOW_UNINSTALL_APPS)
                    dpm.clearUserRestriction(adminComponent, UserManager.DISALLOW_APPS_CONTROL)
                }

                Log.i("LockScreenSecurity", "Protección Anti-ADB Uninstall configurada: $enableBlock")
            } else {
                Log.w("LockScreenSecurity", "App no es Device Owner. Ejecutar: adb shell dpm set-device-owner")
            }
        }

        fun isUninstallBlocked(context: Context): Boolean {
            val dpm = context.getSystemService(Context.DEVICE_POLICY_SERVICE) as? DevicePolicyManager ?: return false
            val adminComponent = getComponentName(context)
            return if (dpm.isDeviceOwnerApp(context.packageName)) {
                dpm.isUninstallBlocked(adminComponent, context.packageName)
            } else {
                false
            }
        }
    }

    override fun onEnabled(context: Context, intent: Intent) {
        super.onEnabled(context, intent)
        Log.i("LockScreenSecurity", "Device Admin activado en Nebula AIOS (Android 15).")
        // Bloquear desinstalación inmediatamente al ser activado
        enforceAntiAdbUninstallProtection(context, true)
    }
}


