### RUTA DE ARCHIVO: app/src/main/java/com/security/lockscreen/LockScreenReceiver.kt
### DESCRIPCIÓN: Gestor del overlay invisible de 80px en el borde superior que absorbe el gesto táctil.
################################################################################

package com.security.lockscreen

import android.app.KeyguardManager
import android.content.BroadcastReceiver
import android.content.Context
import android.content.Intent
import android.graphics.PixelFormat
import android.os.Build
import android.util.Log
import android.view.Gravity
import android.view.View
import android.view.WindowManager

/**
 * Receptor de eventos del ciclo de pantalla.
 * Al apagarse la pantalla o estar bloqueada, monta una vista invisible en el borde superior (80-84px)
 * que consume y absorbe cualquier swipe hacia abajo antes de que SystemUI lo reciba.
 * Al desbloquearse el equipo (ACTION_USER_PRESENT), la barrera se retira al instante.
 */
class LockScreenReceiver : BroadcastReceiver() {

    companion object {
        private var blockerLayout: View? = null
        // Altura calibrada para Nubia Z60 Ultra (pantalla completa sin notch, bezels de 1.48mm)
        private const val OVERLAY_HEIGHT_PX = 84
    }

    override fun onReceive(context: Context, intent: Intent) {
        val action = intent.action ?: return
        val windowManager = context.getSystemService(Context.WINDOW_SERVICE) as? WindowManager ?: return
        val keyguardManager = context.getSystemService(Context.KEYGUARD_SERVICE) as? KeyguardManager

        Log.d("LockScreenSecurity", "Broadcast recibido: $action")

        when (action) {
            Intent.ACTION_SCREEN_OFF, Intent.ACTION_SCREEN_ON -> {
                // Si la pantalla está bloqueada, montar la capa superior invisible
                if (keyguardManager?.isKeyguardLocked == true) {
                    addTopEdgeBlocker(context, windowManager)
                }
            }

            Intent.ACTION_USER_PRESENT -> {
                // El usuario se autenticó correctamente con PIN o huella dactilar: Retirar barrera
                removeTopEdgeBlocker(windowManager)
            }

            Intent.ACTION_BOOT_COMPLETED -> {
                // Iniciar servicio en primer plano tras reinicio
                SecurityForegroundService.startService(context)
            }
        }
    }

    private fun addTopEdgeBlocker(context: Context, windowManager: WindowManager) {
        if (blockerLayout != null) return

        try {
            val layoutType = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY
            } else {
                @Suppress("DEPRECATION")
                WindowManager.LayoutParams.TYPE_SYSTEM_ERROR
            }

            val params = WindowManager.LayoutParams(
                WindowManager.LayoutParams.MATCH_PARENT,
                OVERLAY_HEIGHT_PX,
                layoutType,
                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
                        WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
                        WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
                PixelFormat.TRANSLUCENT
            ).apply {
                gravity = Gravity.TOP
            }

            val view = View(context).apply {
                // Consumir el evento táctil para que el panel de notificación no reciba el swipe
                setOnTouchListener { _, _ ->
                    Log.v("LockScreenSecurity", "Swipe absorbido en zona superior por overlay invisible.")
                    true
                }
            }

            windowManager.addView(view, params)
            blockerLayout = view
            Log.i("LockScreenSecurity", "Barrera táctil superior montada con éxito ($OVERLAY_HEIGHT_PX px).")
        } catch (e: Exception) {
            Log.e("LockScreenSecurity", "Error al montar overlay superior: ${e.message}")
        }
    }

    private fun removeTopEdgeBlocker(windowManager: WindowManager) {
        blockerLayout?.let {
            try {
                windowManager.removeView(it)
                Log.i("LockScreenSecurity", "Barrera táctil superior retirada (Dispositivo desbloqueado).")
            } catch (e: Exception) {
                Log.e("LockScreenSecurity", "Error al retirar overlay: ${e.message}")
            }
            blockerLayout = null
        }
    }
}


