### RUTA DE ARCHIVO: app/src/main/java/com/security/lockscreen/MainActivity.kt
### DESCRIPCIÓN: Interfaz con interruptor normal para habilitar/deshabilitar la protección (con autenticación segura) y estado Anti-ADB.
################################################################################

package com.security.lockscreen

import android.app.admin.DevicePolicyManager
import android.content.Context
import android.content.Intent
import android.content.SharedPreferences
import android.net.Uri
import android.os.Build
import android.os.Bundle
import android.os.PowerManager
import android.provider.Settings
import android.widget.Button
import android.widget.Switch
import android.widget.TextView
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity
import androidx.biometric.BiometricPrompt
import androidx.core.content.ContextCompat
import java.util.concurrent.Executor

class MainActivity : AppCompatActivity() {

    private lateinit var prefs: SharedPreferences
    private lateinit var switchNormalToggle: Switch
    private lateinit var tvAdbAntiUninstallStatus: TextView
    private lateinit var executor: Executor
    private lateinit var biometricPrompt: BiometricPrompt

    companion object {
        const val PREF_PROTECTION_ENABLED = "pref_protection_enabled"
        const val PREF_ANTI_ADB_ENABLED = "pref_anti_adb_enabled"
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        prefs = getSharedPreferences("security_lock_prefs", Context.MODE_PRIVATE)
        executor = ContextCompat.getMainExecutor(this)

        setupBiometrics()
        initViews()
        updateStatus()

        // Iniciar servicio guardián persistente
        SecurityForegroundService.startService(this)
    }

    private fun initViews() {
        switchNormalToggle = findViewById(R.id.switchNormalToggle)
        tvAdbAntiUninstallStatus = findViewById(R.id.tvAdbAntiUninstallStatus)

        val isEnabled = prefs.getBoolean(PREF_PROTECTION_ENABLED, true)
        switchNormalToggle.isChecked = isEnabled

        // Interruptor que permite al usuario legítimo habilitar o deshabilitar normalmente
        switchNormalToggle.setOnClickListener {
            // Requiere autenticación biométrica o PIN antes de deshabilitar
            promptAuthenticationToToggle(!switchNormalToggle.isChecked)
        }

        findViewById<Button>(R.id.btnAdbProtection).setOnClickListener {
            val dpm = getSystemService(Context.DEVICE_POLICY_SERVICE) as DevicePolicyManager
            if (dpm.isDeviceOwnerApp(packageName)) {
                val current = SecurityDeviceAdminReceiver.isUninstallBlocked(this)
                SecurityDeviceAdminReceiver.enforceAntiAdbUninstallProtection(this, !current)
                updateStatus()
                Toast.makeText(this, "Anti-Desinstalación ADB: " + if (!current) "ACTIVADO" else "DESACTIVADO", Toast.LENGTH_SHORT).show()
            } else {
                Toast.makeText(this, "Ejecuta el comando ADB para activar modo Device Owner primero", Toast.LENGTH_LONG).show()
            }
        }
    }

    private fun setupBiometrics() {
        biometricPrompt = BiometricPrompt(this, executor, object : BiometricPrompt.AuthenticationCallback() {
            override fun onAuthenticationSucceeded(result: BiometricPrompt.AuthenticationResult) {
                super.onAuthenticationSucceeded(result)
                val newState = !prefs.getBoolean(PREF_PROTECTION_ENABLED, true)
                prefs.edit().putBoolean(PREF_PROTECTION_ENABLED, newState).apply()
                switchNormalToggle.isChecked = newState
                Toast.makeText(applicationContext, "Protección " + if (newState) "Habilitada" else "Deshabilitada", Toast.LENGTH_SHORT).show()
                updateStatus()
            }

            override fun onAuthenticationFailed() {
                super.onAuthenticationFailed()
                switchNormalToggle.isChecked = prefs.getBoolean(PREF_PROTECTION_ENABLED, true)
                Toast.makeText(applicationContext, "Autenticación fallida", Toast.LENGTH_SHORT).show()
            }
        })
    }

    private fun promptAuthenticationToToggle(targetState: Boolean) {
        val promptInfo = BiometricPrompt.PromptInfo.Builder()
            .setTitle("Confirmar Identidad")
            .setSubtitle("Usa tu huella o PIN para " + if (targetState) "activar" else "desactivar" + " la protección")
            .setNegativeButtonText("Cancelar")
            .build()
        biometricPrompt.authenticate(promptInfo)
    }

    private fun updateStatus() {
        val isAdbBlocked = SecurityDeviceAdminReceiver.isUninstallBlocked(this)
        tvAdbAntiUninstallStatus.text = if (isAdbBlocked)
            "🛡 ANTI-DESINSTALACIÓN ADB: ACTIVO (adb uninstall será rechazado)"
        else
            "⚠ Opcional: Anti-desinstalación ADB no activada aún"
    }
}


