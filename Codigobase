################################################################################
### RUTA DE ARCHIVO: .github/workflows/build-apk.yml
### DESCRIPCIÓN: Workflow de compilación automática en la nube de GitHub Actions (Genera el APK gratis en 2 min).
################################################################################

name: Compilar APK LockScreen Security Lock

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Descargar código fuente
        uses: actions/checkout@v4

      - name: Configurar Java 17
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: Dar permisos de ejecución al gradlew
        run: chmod +x gradlew || true

      - name: Compilar APK Debug
        run: ./gradlew assembleDebug --stacktrace

      - name: Subir APK Generado como Artefacto Descargable
        uses: actions/upload-artifact@v4
        with:
          name: LockScreenSecurityLock-NubiaZ60Ultra.apk
          path: app/build/outputs/apk/debug/app-debug.apk


