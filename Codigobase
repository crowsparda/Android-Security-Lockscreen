################################################################################

#!/usr/bin/env bash
set -e

echo "=========================================================="
echo "Compilando LockScreen Security Lock para Android 15..."
echo "Dispositivo objetivo: Nubia Z60 Ultra (Nebula AIOS)"
echo "=========================================================="

chmod +x gradlew
./gradlew clean assembleRelease

echo ""
echo "✔ ¡Compilación exitosa!"
echo "Tu APK está listo en: app/build/outputs/apk/release/app-release-unsigned.apk"
echo ""
echo "Para instalarlo en tu Nubia Z60 Ultra vía USB:"
echo "  adb install -r app/build/outputs/apk/release/app-release-unsigned.apk"
echo "=========================================================="

